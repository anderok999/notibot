# Copia este archivo a .env y completa los valores reales.
# En Render, configura estas variables en Environment. No subas .env al repo.

TELEGRAM_TOKEN=123456789:AAH...
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# Uno o varios destinos separados por coma. Puede ser un chat privado,
# un grupo (ID negativo) o un canal (@nombre_del_canal).
CHAT_ID=-1001234567890
# CHAT_IDS=-1001234567890,@mi_canal

# Opcional: si se define, solo estos user IDs pueden pedir boletines.
# ALLOWED_USER_IDS=123456789,987654321

TIMEZONE=America/La_Paz
SCHEDULE_TIMES=07:00,12:00,19:00
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Scraping y selección
MAX_ARTICLES_PER_SOURCE=20
NEWS_UNITEL=3
NEWS_REDUNO=2
TOTAL_NEWS=5
REQUEST_TIMEOUT=20
RATE_LIMIT_SECONDS=60

# Servidor y persistencia
PORT=8080
DATA_DIR=data
LOG_LEVEL=INFO
